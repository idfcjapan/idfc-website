{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "idfc-analytics",
  "main": "index.js",
  "compatibility_date": "2026-11-01",
  "workers_dev": true,
  "preview_urls": false,
  // Logs off: request details (which could include IP addresses) are not kept.
  "observability": { "enabled": false },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "idfc-analytics",
      "database_id": "681c530f-5c7e-4aa9-9fe4-2def01b298ec",
      "migrations_dir": "migrations"
    }
  ]
}
